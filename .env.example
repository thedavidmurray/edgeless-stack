# Edgeless Stack Environment Configuration
# Copy to .env and fill in your values: cp .env.example .env

# === Model Provider (pick one or more) ===
# CUSTOMIZE: Add your preferred AI provider API key
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...
# GEMINI_API_KEY=...

# === ChromaDB (Vector Memory) ===
# CUSTOMIZE: Only needed if using semantic search layer
CHROMA_HOST=localhost
CHROMA_PORT=8000
# CHROMA_AUTH_TOKEN=your-secret-token

# === Telegram Notifications ===
# CUSTOMIZE: Get from @BotFather on Telegram
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=your-chat-id

# === Email (Optional -- for email triage cron job) ===
# CUSTOMIZE: App-specific password, not your real password
# EMAIL_ADDRESS=you@gmail.com
# EMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# EMAIL_IMAP_HOST=imap.gmail.com

# === Agent Bus ===
AGENT_BUS_PORT=9800

# === Paths ===
# CUSTOMIZE: Adjust to match your project layout
PROJECT_ROOT=.
VAULT_PATH=./vault
MEMORY_DB_PATH=./data/shared_memory/events.sqlite3
OBSIDIAN_VAULT_PATH=~/Documents/ObsidianVault

# === Behavior ===
# CUSTOMIZE: Tune agent behavior
MAX_CRON_RETRIES=3
CRON_LOG_DIR=./logs
HEALTH_CHECK_INTERVAL=360
SILENCE_MEANS_SUCCESS=true
